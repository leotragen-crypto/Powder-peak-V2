function writeQuad(a,b,c,d){const o=trkI*18;const v=[a,b,c,b,d,c];for(let k=0;k<6;k++){trkPos[o+k*3]=v[k].x;trkPos[o+k*3+1]=v[k].y;trkPos[o+k*3+2]=v[k].z;}trkLo=Math.min(trkLo,trkI);trkHi=Math.max(trkHi,trkI);trkI++;if(trkI>=TRK_N){trkI=0;trkWrap=true;}}
function trackStep(n,f){
  const ski=gear==='ski';
  _tl.crossVectors(n,f).normalize();
  const sk=clamp(P.skid+(keys.KeyS?0.6:0),0,1);
  const lanesDef=ski?[[0.12,0.09+0.35*sk],[-0.12,0.09+0.35*sk]]:[[0,0.28+1.0*sk]];
  for(let li=0;li<2;li++){
    const ln=lanes[li];if(li>=lanesDef.length){ln.has=false;continue;}
    const off=lanesDef[li][0],w=lanesDef[li][1];
    _tc.copy(P.pos).addScaledVector(n,0.07).addScaledVector(_tl,off);
    _tL.copy(_tc).addScaledVector(_tl,w/2);_tR.copy(_tc).addScaledVector(_tl,-w/2);
    if(!ln.has){ln.has=true;ln.c.copy(_tc);ln.L.copy(_tL);ln.R.copy(_tR);continue;}
    const d=_tc.distanceTo(ln.c);
    if(d>6){ln.c.copy(_tc);ln.L.copy(_tL);ln.R.copy(_tR);continue;}
    if(d>0.45){writeQuad(ln.L,ln.R,_tL,_tR);ln.c.copy(_tc);ln.L.copy(_tL);ln.R.copy(_tR);}
  }
}
