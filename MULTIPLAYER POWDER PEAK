const _lp=new V3(),_ld=new V3(),_dum=new THREE.Object3D();
function updateLiftVis(t){
  for(const V of LIFT_VIS){
    const L=V.L;const poly=L.type==='chair'?L.cable:L.ride;const len=poly.len,loop=len*2;
    for(let i=0;i<V.count;i++){
      const u=(t*L.speed+i*V.spacing)%loop;const up=u<len;const s=up?u:loop-u;
      polyAt(poly,s,_lp,_ld);
      let yaw=Math.atan2(_ld.x,_ld.z);
      if(L.type==='chair'){if(!up){_lp.x+=DOWN_OFF;yaw+=PI;}_dum.position.copy(_lp);_dum.rotation.set(0,yaw,0);_dum.scale.set(1,1,1);}
      else if(L.type==='rope'){if(up){_lp.y+=1.0;}else{_lp.x+=1.3;_lp.y+=1.5;}_dum.position.copy(_lp);_dum.rotation.set(0,yaw,0);_dum.scale.set(1,1,1);}
      else{
        const cy=L.cableY(_lp.z);const off=up?0:2.2;
        const bottom=up?_lp.y+0.95:cy-1.2;const rl=Math.max(0.5,cy-bottom);
        _dum.position.set(_lp.x+off,cy,_lp.z);_dum.rotation.set(0,yaw,0);_dum.scale.set(1,rl,1);_dum.updateMatrix();V.inst.setMatrixAt(i,_dum.matrix);
        _dum.position.set(_lp.x+off,cy-rl,_lp.z);_dum.scale.set(1,1,1);_dum.updateMatrix();V.bar.setMatrixAt(i,_dum.matrix);
        continue;
      }
      _dum.updateMatrix();V.inst.setMatrixAt(i,_dum.matrix);
    }
    V.inst.instanceMatrix.needsUpdate=true;if(V.bar)V.bar.instanceMatrix.needsUpdate=true;
  }
}

