<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&family=VT323&display=swap" rel="stylesheet">
<style>
/* Layout: full-bleed low-res canvas; HUD pinned to corners; combo meter bottom-centre; trail map bottom-right */
:root{
  --night:#0d1233; --panel:rgba(13,18,51,.84); --edge:#34449a;
  --snow:#f4f2ff; --frost:#a9d8ff; --sun:#ffb347; --flag:#ff4f6d; --pine:#6ee7a8; --dim:#9aa3d4;
  --display:'Pixelify Sans','Courier New',ui-monospace,monospace;
  --mono:'VT323','Courier New',ui-monospace,monospace;
  color-scheme:dark;
}
html,body{height:100%}
body{margin:0;overflow:hidden;background:var(--night);color:var(--snow);font-family:var(--mono);font-size:20px;line-height:1.1;-webkit-font-smoothing:none}
#view{position:fixed;inset:0;width:100vw;height:100vh;display:block;image-rendering:pixelated;image-rendering:crisp-edges;outline:none}
.scan{position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(to bottom,transparent 0 2px,rgba(10,10,40,.07) 2px 3px)}
#hud{position:fixed;inset:0;pointer-events:none;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:max(12px,env(safe-area-inset-top,0px)) max(12px,env(safe-area-inset-bottom,0px));box-sizing:border-box}
.hin{position:relative;width:100%;height:100%}
.panel{background:var(--panel);border:2px solid var(--edge);box-shadow:0 0 0 2px var(--night),4px 4px 0 2px rgba(0,0,0,.35);padding:8px 12px}
.lbl{font-size:16px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase}
.lcol{position:absolute;top:0;left:0;display:grid;gap:10px;justify-items:start}
.stats{min-width:180px;display:grid;gap:2px}
#board{min-width:200px;max-width:260px;padding:6px 10px;pointer-events:auto}
#boardHead{all:unset;cursor:pointer;font-family:var(--display);font-size:15px;letter-spacing:.08em;color:var(--frost);display:block}
#boardHead:focus-visible{outline:2px solid var(--frost)}
#boardList{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:2px}
#boardList li{display:grid;grid-template-columns:18px 12px minmax(0,1fr) auto;gap:6px;align-items:center;font-size:18px}
#boardList li.me{color:var(--sun)}
#boardList .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
#boardList b{font-weight:400;font-variant-numeric:tabular-nums}
#boardList .rk{color:var(--dim)}
#board.collapsed #boardList{display:none}
#mapwrap{pointer-events:auto;cursor:pointer}
.txt{font-family:var(--display);font-size:19px;background:var(--night);color:var(--snow);border:2px solid var(--edge);padding:7px 10px;min-width:0}
.txt:focus-visible{outline:3px solid var(--frost);outline-offset:2px}
#nick{width:12ch}
#mpCode{width:5.2ch;letter-spacing:.2em;text-align:center;font-variant-numeric:tabular-nums}
#mpStatus{color:var(--frost)}
.go.alt[disabled]{opacity:.45;cursor:not-allowed}
#bigmap{position:fixed;inset:0;display:grid;place-items:center;background:rgba(13,18,51,.84);padding-block:14px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));box-sizing:border-box;z-index:5}
.bm{display:grid;gap:10px;max-width:100%}
.bmhead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.bmwrap{position:relative;justify-self:center}
#bmCanvas{display:block;image-rendering:pixelated;border:2px solid var(--edge);width:100%;height:100%}
.tp{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:5px;padding:2px 7px 2px 3px;background:var(--panel);border:2px solid var(--edge);color:var(--snow);font-family:var(--display);font-size:14px;cursor:pointer;white-space:nowrap}
.tp i{width:11px;height:11px;transform:rotate(45deg);background:var(--sun);border:2px solid var(--night);flex:none}
.tp.locked{color:var(--dim)}
.tp.locked i{background:transparent;border-color:var(--dim)}
.tp:focus-visible{outline:3px solid var(--frost)}
#bmMsg{min-height:1.2em;color:var(--sun);font-size:19px}
.big{font-family:var(--display);font-weight:700;font-size:30px;color:var(--sun);font-variant-numeric:tabular-nums}
.row{display:flex;gap:10px;font-variant-numeric:tabular-nums}
.row b{color:var(--frost);font-weight:400}
.area{font-family:var(--display);font-size:16px;margin-top:4px;display:flex;align-items:center;gap:6px}
.dot{width:10px;height:10px;display:inline-block;border:2px solid var(--snow);flex:none}
.help{position:absolute;top:0;right:0;font-size:17px;max-width:270px;display:grid;grid-template-columns:auto 1fr;gap:1px 10px}
.help kbd{font-family:var(--mono);color:var(--sun);white-space:nowrap}
#banner{position:absolute;left:50%;top:17%;transform:translateX(-50%);text-align:center;opacity:0;transition:opacity .15s;max-width:92%}
#banner .m{font-family:var(--display);font-weight:700;font-size:clamp(28px,5vw,54px);letter-spacing:.04em;text-shadow:3px 3px 0 var(--night),-2px -2px 0 var(--night),2px -2px 0 var(--night),-2px 2px 0 var(--night);text-wrap:balance}
#banner .s{font-size:24px;margin-top:4px;text-shadow:2px 2px 0 var(--night)}
#banner.good .m{color:var(--pine)} #banner.bad .m{color:var(--flag)} #banner.warn .m{color:var(--sun)} #banner.info .m{color:var(--frost)}
#live{position:absolute;left:50%;top:31%;transform:translateX(-50%);font-family:var(--display);font-size:22px;color:var(--snow);text-shadow:2px 2px 0 var(--night);white-space:nowrap}
#combo{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:min(460px,calc(100% - 210px));min-width:240px;display:grid;gap:4px;opacity:0;transition:opacity .2s}
#combo.on{opacity:1}
.ctop{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
#cscore{font-family:var(--display);font-weight:700;font-size:26px;color:var(--snow);font-variant-numeric:tabular-nums}
#cmult{font-family:var(--display);font-weight:700;font-size:26px;color:var(--sun)}
#cnames{font-size:18px;color:var(--frost);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar{height:10px;background:#1c2560;border:2px solid var(--night)}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--flag),var(--sun),var(--pine))}
#charge{position:absolute;left:50%;bottom:118px;transform:translateX(-50%);width:160px;display:grid;gap:3px;opacity:0;text-align:center}
#charge .bar i{background:var(--frost)}
#prompt{position:absolute;left:50%;top:62%;transform:translateX(-50%);font-size:22px;white-space:nowrap;opacity:0;text-shadow:2px 2px 0 var(--night)}
#prompt kbd{display:inline-block;background:var(--sun);color:var(--night);padding:0 6px;margin:0 6px;font-family:var(--display);font-weight:700;text-shadow:none}
#mapwrap{position:absolute;right:0;bottom:0;padding:6px}
#map{display:block;width:150px;image-rendering:pixelated}
.maplbl{font-size:14px;color:var(--dim);letter-spacing:.1em;margin-bottom:3px}
#menu{position:fixed;inset:0;display:grid;place-items:center;background:radial-gradient(ellipse at 50% 40%,rgba(13,18,51,.35),rgba(13,18,51,.9));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:24px;overflow:auto;box-sizing:border-box}
.card{width:min(760px,100%);display:grid;gap:16px}
.title{font-family:var(--display);font-weight:700;font-size:clamp(44px,9vw,84px);line-height:.9;letter-spacing:.02em;color:var(--snow);text-shadow:4px 4px 0 var(--flag),8px 8px 0 var(--night);text-wrap:balance}
.title span{color:var(--sun)}
.tag{font-size:22px;color:var(--frost)}
.gear{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.gbtn{font-family:var(--display);font-size:22px;font-weight:700;color:var(--snow);background:var(--panel);border:2px solid var(--edge);padding:14px 10px;cursor:pointer;text-align:left;display:grid;gap:4px}
.gbtn small{font-family:var(--mono);font-weight:400;font-size:17px;color:var(--dim)}
.gbtn[aria-pressed="true"]{border-color:var(--sun);box-shadow:0 0 0 2px var(--sun) inset;color:var(--sun)}
.gbtn:focus-visible,.go:focus-visible{outline:3px solid var(--frost);outline-offset:2px}
.go{font-family:var(--display);font-weight:700;font-size:26px;background:var(--sun);color:var(--night);border:0;padding:12px 18px;cursor:pointer;box-shadow:4px 4px 0 var(--flag)}
.go:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--flag)}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px 22px}
.sec{display:grid;gap:2px;min-width:0}
.sec h3{margin:0 0 4px;font-family:var(--display);font-size:17px;letter-spacing:.12em;color:var(--dim);font-weight:500}
.keys div{display:flex;gap:8px;min-width:0;font-size:19px}
.keys kbd{font-family:var(--mono);color:var(--sun);min-width:96px;flex:none}
.note{font-size:17px;color:var(--dim)}
.settings{display:grid;gap:12px}
.setrow{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px}
.setrow .lbl{min-width:130px}
.seg{display:flex}
.seg button{font-family:var(--display);font-size:18px;font-weight:700;color:var(--snow);background:var(--night);border:2px solid var(--edge);padding:8px 14px;cursor:pointer}
.seg button+button{border-left:0}
.seg button[aria-pressed="true"]{background:var(--sun);color:var(--night);border-color:var(--sun)}
.seg button:focus-visible,.go.alt:focus-visible,#camAngle:focus-visible,#gfx:focus-visible{outline:3px solid var(--frost);outline-offset:2px}
.range{flex:1;min-width:200px;display:flex;align-items:center;gap:12px}
#camAngle,#gfx{flex:1;min-width:0;height:28px;accent-color:var(--sun)}
#camVal{font-variant-numeric:tabular-nums;min-width:96px;color:var(--frost)}
.btnrow{display:flex;gap:12px;flex-wrap:wrap}
.go.alt{background:var(--panel);color:var(--snow);border:2px solid var(--edge);box-shadow:4px 4px 0 var(--edge);font-size:20px}
body.touchmode .konly{display:none}
body:not(.touchmode) .tonly{display:none}
#touch{position:fixed;inset:0;pointer-events:none;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;
  --st:min(150px,34vh);--tb:min(46px,10vh);--gx:max(18px,env(safe-area-inset-left,0px));--gr:max(18px,env(safe-area-inset-right,0px));--gb:max(18px,env(safe-area-inset-bottom,0px))}
#touch .c{pointer-events:auto;position:absolute;touch-action:none;-webkit-tap-highlight-color:transparent}
.stick{width:var(--st);height:var(--st);border-radius:50%;background:rgba(13,18,51,.42);border:2px solid rgba(169,216,255,.6);box-sizing:border-box}
.stick i{position:absolute;left:50%;top:50%;width:44%;height:44%;margin:-22% 0 0 -22%;border-radius:50%;background:rgba(244,242,255,.88);border:2px solid var(--night);box-sizing:border-box}
.stick b{position:absolute;left:-20px;right:-20px;top:-22px;text-align:center;font-family:var(--display);font-size:13px;letter-spacing:.12em;color:var(--frost);font-weight:500;text-shadow:1px 1px 0 var(--night)}
#stickL{left:var(--gx);bottom:var(--gb)}
#stickR{right:var(--gr);bottom:var(--gb)}
.tbtn{display:grid;place-items:center;padding:0;font-family:var(--display);font-weight:700;color:var(--night);background:rgba(244,242,255,.88);border:2px solid var(--night);border-radius:50%;box-sizing:border-box;box-shadow:3px 3px 0 rgba(13,18,51,.5)}
.tbtn.on{background:var(--sun);transform:translate(2px,2px);box-shadow:1px 1px 0 rgba(13,18,51,.5)}
.tgrid{left:var(--gx);bottom:calc(var(--gb) + var(--st) + 28px);display:grid;grid-template-columns:repeat(5,var(--tb));gap:6px}
.tgrid .tbtn{position:static;width:var(--tb);height:var(--tb);border-radius:8px;font-size:20px}
.jump{width:calc(var(--st)*.62);height:calc(var(--st)*.62);right:calc(var(--gr) + var(--st) + 16px);bottom:var(--gb);font-size:18px}
.lift{width:calc(var(--st)*.46);height:calc(var(--st)*.46);right:calc(var(--gr) + var(--st)*.27);bottom:calc(var(--gb) + var(--st) + 28px);font-size:14px;background:rgba(255,179,71,.92)}
.pause{width:44px;height:44px;border-radius:8px;top:max(12px,env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);font-size:18px}
.pause.on{transform:translateX(-50%)}
body.touchmode .help{display:none}
body.touchmode #mapwrap{top:0;bottom:auto}
body.touchmode #map{width:92px}
body.touchmode #combo{bottom:auto;top:52px;width:min(420px,calc(100% - 300px));min-width:200px}
body.touchmode #banner{top:30%}
body.touchmode #charge{bottom:calc(var(--gb,18px) + min(150px,34vh) + 20px)}
body.touchmode #prompt{pointer-events:auto;cursor:pointer;top:auto;bottom:calc(min(150px,34vh)*.75)}
#loading{position:fixed;inset:0;display:grid;place-items:center;font-family:var(--display);font-size:24px;background:var(--night);color:var(--frost);text-align:center;padding:16px}
@media (max-width:640px){.help{display:none}#combo{width:calc(100% - 20px);min-width:0;bottom:250px}#map{width:110px}#charge{bottom:330px}}
@media (prefers-reduced-motion:reduce){#banner{transition:none}}
</style>

<canvas id="view" tabindex="0"></canvas>
<div class="scan"></div>
<div id="hud" hidden>
  <div class="hin">
    <div class="lcol">
    <div class="stats panel">
      <div class="lbl">Score</div>
      <div id="score" class="big">0</div>
      <div class="row"><span><b id="speed">0</b> km/h</span><span>alt <b id="alt">0</b> m</span></div>
      <div id="area" class="area"><i class="dot"></i><span>Summit</span></div>
    </div>
    <div id="board" class="panel" hidden><button id="boardHead" type="button">CREW <span id="boardCode"></span> · <span id="boardCount"></span> ▾</button><ol id="boardList"></ol></div>
    </div>
    <div class="help panel" id="help">
      <kbd>WASD</kbd><span>tuck · carve · brake</span>
      <kbd>Space</kbd><span>tap hop · hold pump + charge</span>
      <kbd>← →  ↑ ↓</kbd><span>spin · flip</span>
      <kbd>+A/D</kbd><span>cork (with spin) · wildcat (with flip)</span>
      <kbd>+W / +S</kbd><span>bio / flatspin · tucked / layout</span>
      <kbd>1 2 6 7 8</kbd><span>grabs (hold)</span>
      <kbd>3 4 5 9</kbd><span>shifty · backflip · rodeo · cork</span>
      <kbd>F · N</kbd><span>ride lift · map + teleport</span>
      <kbd>R · Esc · H · L</kbd><span>summit · menu · hide · crew</span>
    </div>
    <div id="banner"><div class="m"></div><div class="s"></div></div>
    <div id="live"></div>
    <div id="prompt"></div>
    <div id="charge"><div class="lbl">Pump · charge</div><div class="bar"><i></i></div></div>
    <div id="combo" class="panel">
      <div class="ctop"><span id="cscore">0</span><span id="cmult">×1</span></div>
      <div id="cnames"></div>
      <div class="bar"><i id="cbar"></i></div>
    </div>
    <div id="mapwrap" class="panel"><div class="maplbl">TRAIL MAP</div><canvas id="map"></canvas></div>
  </div>
</div>
<div id="menu" hidden>
  <div class="card">
    <div class="title">POWDER<br><span>PEAK</span></div>
    <div class="tag" id="menuTag">Eight trails, three parks, a superpipe and the Colossus. Pick your gear.</div>
    <div class="gear">
      <button class="gbtn" id="gSki" type="button" aria-pressed="true">SKIS<small>Quick edges, pole plants, Iron Cross</small></button>
      <button class="gbtn" id="gBoard" type="button" aria-pressed="false">SNOWBOARD<small>Sideways stance, butters, boardslides</small></button>
    </div>
    <div class="settings panel">
      <div class="setrow"><span class="lbl">Controls</span><div class="seg" role="group" aria-label="Controls"><button id="cKeys" type="button" aria-pressed="true">Keyboard</button><button id="cTouch" type="button" aria-pressed="false">Touch screen</button></div></div>
      <div class="setrow"><label class="lbl" for="gfx">Graphics</label><div class="range"><input type="range" id="gfx" min="1" max="5" step="1" value="3"><span id="gfxVal">Medium</span></div></div>
      <div class="note" id="gfxNote">Classic retro look</div>
      <div class="setrow"><label class="lbl" for="camAngle">Camera angle</label><div class="range"><input type="range" id="camAngle" min="-180" max="180" step="5" value="0"><span id="camVal">Behind</span></div></div>
    </div>
    <div class="settings panel">
      <div class="setrow"><span class="lbl">Multiplayer</span><span id="mpStatus">Riding solo</span></div>
      <div class="setrow"><label class="lbl" for="nick">Your name</label><input class="txt" id="nick" type="text" maxlength="14" autocomplete="off" spellcheck="false"></div>
      <div class="setrow"><span class="lbl">Game code</span><button class="go alt" id="mpHost" type="button">Host game</button><input class="txt" id="mpCode" type="text" inputmode="numeric" maxlength="4" placeholder="0000" autocomplete="off" aria-label="4-digit game code"><button class="go alt" id="mpJoin" type="button">Join</button><button class="go alt" id="mpLeave" type="button" hidden>Leave</button></div>
    </div>
    <div class="btnrow"><button class="go" id="goBtn" type="button">Drop in ▸</button><button class="go alt" id="summitBtn" type="button" hidden>Back to summit</button><button class="go alt" id="sndBtn" type="button">Sound on</button></div>
    <div class="cols">
      <div class="sec keys tonly">
        <h3>TOUCH CONTROLS</h3>
        <div><kbd>Left stick</kbd><span>carve left and right · push up to tuck · pull down to brake</span></div>
        <div><kbd>Right stick</kbd><span>spin and flip in the air, same as the arrow keys</span></div>
        <div><kbd>Both sticks</kbd><span>left stick works as WASD, so spin + side = Cork</span></div>
        <div><kbd>JUMP</kbd><span>tap to hop, hold to pump and charge</span></div>
        <div><kbd>1–9 pad</kbd><span>same as the number keys · hold grabs</span></div>
        <div><kbd>LIFT</kbd><span>ride a lift, or tap the lift prompt</span></div>
        <div><kbd>Trail map</kbd><span>tap it to open the big map and teleport</span></div>
        <div><kbd>II</kbd><span>pause · camera angle · back to summit</span></div>
      </div>
      <div class="sec keys konly">
        <h3>RIDING</h3>
        <div><kbd>A / D</kbd><span>carve. Faster means wider arcs</span></div>
        <div><kbd>W</kbd><span>tuck for speed</span></div>
        <div><kbd>S</kbd><span>brake · hockey stop</span></div>
        <div><kbd>Space</kbd><span>tap to hop, hold to pump and charge a big ollie</span></div>
        <div><kbd>Flats</kbd><span>you pole or shimmy on your own</span></div>
        <div><kbd>F</kbd><span>chairlifts, T-bars, rope tow</span></div>
        <div><kbd>N / map</kbd><span>open the trail map, teleport to places you've visited</span></div>
        <div><kbd>R / P / M</kbd><span>summit · graphics level · sound</span></div>
      </div>
      <div class="sec keys">
        <h3 class="konly">AIR · ARROWS + WASD</h3><h3 class="tonly">AIR · RIGHT STICK + LEFT STICK</h3>
        <div><kbd>← →</kbd><span>spin 180 to 1080+</span></div>
        <div><kbd>↑ / ↓</kbd><span>frontflip / backflip</span></div>
        <div><kbd>←→ + A/D</kbd><span>Cork · Double at 1080 · Triple at 1440</span></div>
        <div><kbd>←→ + ↑ / ↓</kbd><span>Misty / Rodeo</span></div>
        <div><kbd>←→ + W / S</kbd><span>Bio / Flatspin</span></div>
        <div><kbd>↑↓ + A/D</kbd><span>Tamedog / Wildcat</span></div>
        <div><kbd>↑↓ + W / S</kbd><span>Tucked (faster) / Layout (more points)</span></div>
        <div><kbd>W / S alone</kbd><span>tilt to save a landing</span></div>
      </div>
      <div class="sec keys">
        <h3>SCORING</h3>
        <div><kbd>360 / 720 / 1080</kbd><span>300 / 760 / 1,370</span></div>
        <div><kbd>Flip</kbd><span>500 · double 1,350 · layout ×1.4</span></div>
        <div><kbd>Rodeo 540</kbd><span>1,130</span></div>
        <div><kbd>Cork 720 / 1080</kbd><span>1,070 / 1,780 (double)</span></div>
        <div><kbd>Grab</kbd><span>100 + 160 per second held</span></div>
        <div><kbd>Air time</kbd><span>+60 per second · Colossal Air +400</span></div>
        <div><kbd>Landing</kbd><span>clean ×1 · sketchy ×0.6 · flunk loses the combo</span></div>
        <div><kbd>Combo</kbd><span>× number of different tricks · repeats score half</span></div>
      </div>
      <div class="sec keys">
        <h3>NUMBER KEYS / TRICK PAD</h3>
        <div><kbd>1 2 6 7 8</kbd><span>grabs in the air (hold to tweak)</span></div>
