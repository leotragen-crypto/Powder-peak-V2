  if(game.state==='play'){acc+=dt;let n=0;while(acc>=FIXED&&n<8){step(FIXED);acc-=FIXED;n++;}if(n===8)acc=0;}
  const vt=now/1000;waterTime.value=vt;
  updateLiftVis(vt);
  animateRider(game.state==='play'?dt:0.016);
  updateCamera(dt);
  sun.position.copy(P.pos).addScaledVector(SUNDIR,320);sun.target.position.copy(P.pos);
  if(TREE_MESHES.length){const cx=camera.position.x,cz=camera.position.z,R=TREE_DIST+180;for(const t of TREE_MESHES){const dx=t.x-cx,dz=t.z-cz;t.m.visible=dx*dx+dz*dz<R*R;}}
  pMat.uniforms.uScale.value=renderer.domElement.height/(2*Math.tan(camera.fov*PI/360));
  updParticles(dt);if(SN)updSnow(dt);flushTracks();
  if(game.state==='play'){updateHUD(dt);drawMap();discoverTick(dt);}
  mpTick(dt);updRemotes(dt);hutSmoke(dt);if(game.state==='map'){bmT-=dt;if(bmT<=0){bmT=0.25;drawBigMap();}}
  renderer.render(scene,camera);
}

/* ================= BOOT ================= */
const tick=()=>new Promise(r=>setTimeout(r,16));
async function boot(){
  const ld=$('loading');
  try{await Promise.race([document.fonts.load('700 30px "Pixelify Sans"'),new Promise(r=>setTimeout(r,1500))]);}catch(e){}
  const steps=[['Shaping the mountain…',buildTerrain],['Raising the far peaks…',buildRanges],['Filling the lakes…',buildLakes],['Building jumps and the superpipe…',buildFeatures],['Stringing the lifts…',buildLifts],['Planting the forest…',buildTrees],['Placing rocks and chalets…',()=>{buildRocks();buildChalets();}],['Marking the trails…',()=>{buildMarkers();buildSigns();buildMap();}]];
  for(const [msg,fn] of steps){ld.textContent=msg;await tick();fn();}
  setupShadows();setGfx(GFX_LV);
  respawn(true);
  rig.root.position.copy(P.pos);
  ld.remove();
  openMenu(false);
  requestAnimationFrame(frame);
}
window.__pp={get banner(){return window.__lastBanner;},get extra(){return {teleport,TPS,openMap,closeMap,TP_GOT,discoverTick,peerGame,setScheme:()=>{},onKeyDown,onKeyUp,packPose,upsertRemote,updRemotes,REMOTE,rig};},P,step,trickKey,keys,LIFTS,liftKey,game,combo,RAILS,KICKERS,ZONES,PISTES,LAKES,PIPE,groundH,surf,animateRider,updateHUD,updateCamera,airTrickResult,closeMenu,respawn,setGear,pisteMask,zoneMask,gladeMask,TREES:()=>TREE_LIST,OBST};
boot().catch(e=>{console.error(e);const ld=$('loading');if(ld)ld.textContent='Something went wrong building the mountain. Reload to try again.';});
})();
