function makePoly(pts){const cum=[0];for(let i=1;i<pts.length;i++)cum.push(cum[i-1]+pts[i].distanceTo(pts[i-1]));return{pts,cum,len:cum[cum.length-1]};}
function polyAt(poly,s,out,dir){
