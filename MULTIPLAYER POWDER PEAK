function step(dt){
  T+=dt;
  if(P.railCD>0)P.railCD-=dt;
  switch(P.mode){case'ground':groundStep(dt);break;case'air':airStep(dt);break;case'rail':railStep(dt);break;case'lift':liftStep(dt);break;case'crash':crashStep(dt);break;case'sink':sinkStep(dt);break;}
  if(P.mode==='ground'||P.mode==='rail'){P.q.slerp(P.qG,1-Math.exp(-(P.stumbleT>0?6:13)*dt));P.w.set(0,0,0);}
  if(P.mode==='air'&&spaceHeld)P.charge=0;
  P.shiftyT=Math.max(0,P.shiftyT-dt);P.popT=Math.max(0,P.popT-dt);P.landT=Math.max(0,P.landT-dt);P.pressT=Math.max(0,P.pressT-dt);P.butterT=Math.max(0,P.butterT-dt);
