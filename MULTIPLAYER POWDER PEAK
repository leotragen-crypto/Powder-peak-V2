function groundStep(dt){
  const ski=gear==='ski';
  const s=surf(P.pos.x,P.pos.z);P.onWater=s.water;normalAt(P.pos.x,P.pos.z,_n,s.water);
  const vn=P.vel.dot(_n);
  if(vn<0){const s0=P.vel.length();P.vel.addScaledVector(_n,-vn);const s1=P.vel.length();if(s1>1e-4)P.vel.multiplyScalar(Math.min(s0,s1-vn*0.85)/s1);}
