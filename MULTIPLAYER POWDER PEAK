const TCOL={snow:new THREE.Color(0xe3e9f8),groom:new THREE.Color(0xf7f8ff),park:new THREE.Color(0xfbf7ff),glade:new THREE.Color(0xeef1fb),rock:new THREE.Color(0x6a6a82),bed:new THREE.Color(0x7d93ad)};
